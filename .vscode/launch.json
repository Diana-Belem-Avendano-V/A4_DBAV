{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Iniciar microservicio",
      "program": "${workspaceFolder}/index.js",
      "env": { "PORT": "3000" },
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "escuchando en el puerto ([0-9]+)",
        "uriFormat": "http://localhost:%s",
        "action": "openExternally"
      }
    }
  ]
}
